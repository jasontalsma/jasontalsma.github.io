							</ul>
						</div>
					</div>
				</div>
			</div>
		</footer>

		<div id="audio-player" class="fixed bottom-8 right-8 z-[100]" transition:persist>
			<button id="toggle-audio" class="w-12 h-12 rounded-full border border-[#F9F9F9]/20 flex items-center justify-center hover:bg-[#F9F9F9] hover:text-[#0B0B0B] transition-all group">
				<div id="audio-visual" class="flex items-center justify-center">
					<svg id="play-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-play fill-current"><polygon points="6 3 20 12 6 21 6 3"/></svg>
					<svg id="pause-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pause fill-current hidden"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
				</div>
			</button>
			<audio id="audio-element" src="/music/fogged.wav" preload="metadata"></audio>
		</div>

		<script is:inline>
			// Mobile Menu Logic
			function initMobileMenu() {
				const toggleBtn = document.getElementById('mobile-menu-toggle');
				const menu = document.getElementById('mobile-menu');
				const menuIcon = document.getElementById('menu-icon');
				const closeIcon = document.getElementById('close-icon');

				if (!toggleBtn || !menu) return;

				toggleBtn.onclick = () => {
					const isHidden = menu.classList.contains('hidden');
					if (isHidden) {
						menu.classList.remove('hidden');
						menuIcon.classList.add('hidden');
						closeIcon.classList.remove('hidden');
						document.body.style.overflow = 'hidden';
					} else {
						menu.classList.add('hidden');
						menuIcon.classList.remove('hidden');
						closeIcon.classList.add('hidden');
						document.body.style.overflow = '';
					}
				};

				// Close menu on link click
				const menuLinks = menu.querySelectorAll('a');
				menuLinks.forEach(link => {
					link.onclick = () => {
						menu.classList.add('hidden');
						menuIcon.classList.remove('hidden');
						closeIcon.classList.add('hidden');
						document.body.style.overflow = '';
					};
				});
			}

			// Handle audio player
			function initAudio() {
				const audioEl = document.getElementById('audio-element');
				const toggleBtn = document.getElementById('toggle-audio');
				const playIcon = document.getElementById('play-icon');
				const pauseIcon = document.getElementById('pause-icon');

				if (!audioEl || !toggleBtn) return;

				const updateIcons = () => {
					if (!audioEl.paused) {
						playIcon?.classList.add('hidden');
						pauseIcon?.classList.remove('hidden');
					} else {
						playIcon?.classList.remove('hidden');
						pauseIcon?.classList.add('hidden');
					}
				};

				// Remove old listener
				if (window.handleAudioToggle) {
					toggleBtn.removeEventListener('click', window.handleAudioToggle);
				}

				window.handleAudioToggle = function() {
					if (audioEl.paused) {
						audioEl.play();
					} else {
						audioEl.pause();
					}
				};

				toggleBtn.addEventListener('click', window.handleAudioToggle);
				audioEl.addEventListener('play', updateIcons);
				audioEl.addEventListener('pause', updateIcons);

				updateIcons();
			}

			// Fullscreen Image Lightbox Logic
			function initLightbox() {
				const modal = document.getElementById('image-modal');
				const modalImg = document.getElementById('modal-img');
				// Pulls standard images, bypassing wrapped anchor links explicitly
				const proseImages = document.querySelectorAll('.prose img:not(a img)');

				if (!modal || !modalImg) return;

				proseImages.forEach(img => {
					img.onclick = () => {
						modalImg.src = img.getAttribute('src') || '';
						modalImg.alt = img.getAttribute('alt') || '';
						modal.classList.remove('hidden');
						document.body.style.overflow = 'hidden';
					};
				});

				modal.onclick = closeModal;
				}

				// Global escape listener attached once
				document.addEventListener('keydown', (e) => {
					const modal = document.getElementById('image-modal');
					if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
						modal.classList.add('hidden');
						document.body.style.overflow = '';
						const modalImg = document.getElementById('modal-img');
						if (modalImg) modalImg.src = '';
					}
				});
				
			// Initialize on load and on transitions
			document.addEventListener('astro:page-load', () => {
				initAudio();
				initMobileMenu();
				initLightbox();
			});

			// Initial call for the first load
			if (document.readyState === 'complete') {
				initAudio();
				initMobileMenu();
			} else {
				window.addEventListener('load', () => {
					initAudio();
					initMobileMenu();
				});
			}
			// custom cursor shit
			function initCustomCursor() {
			const dot = document.getElementById('custom-cursor');
			if (!dot) return;

			let mouseX = 0, mouseY = 0;
			
			// Update position
			window.onmousemove = (e) => {
				mouseX = e.clientX;
				mouseY = e.clientY;
				dot.style.left = `${mouseX}px`;
				dot.style.top = `${mouseY}px`;
			};

			// Event delegation to catch dynamic layout elements
			document.body.addEventListener('mouseover', (e) => {
				const target = e.target.closest('a, button, [role="button"], .cursor-zoom-out');
				if (target) {
					dot.classList.add('active');
				}
			});

			document.body.addEventListener('mouseout', (e) => {
				const target = e.target.closest('a, button, [role="button"], .cursor-zoom-out');
				if (target) {
					dot.classList.remove('active');
				}
			});
		}

		// Hook into Astro's lifecycle
		document.addEventListener('astro:page-load', initCustomCursor);
		</script>
		//Fullscreen Lightbox Overlay Container
		<div id="image-modal" class="fixed inset-0 bg-[#0B0B0B]/95 z-[200] hidden flex items-center justify-center cursor-zoom-out" transition:persist>
			<img id="modal-img" class="max-w-[95vw] max-h-[95vh] object-contain select-none transition-transform duration-300" src="" alt="" />
		</div>
	</body>
</html>

<style is:global>
	:root {
		--bg-color: #0B0B0B;
		--text-color: #F9F9F9;
	}
	
	@keyframes audio-bar {
		0% { height: 20%; }
		100% { height: 100%; }
	}

	.animate-audio-bar {
		animation: audio-bar 0.5s infinite alternate;
	}

	::-webkit-scrollbar {
		width: 4px;
	}
	::-webkit-scrollbar-track {
		background: #0B0B0B;
	}
	::-webkit-scrollbar-thumb {
		background: #333;
	}
	::-webkit-scrollbar-thumb:hover {
		background: #555;
	}

	/* Disable default pointer on interactive elements */
	a, button, [role="button"], .cursor-zoom-out {
		cursor: none !important;
	}

	/* Custom Cursor Element */
	.custom-dot {
		width: 12px;
		height: 12px;
		background-color: #000000;
		border: 1px solid rgba(249, 249, 249, 0.4); /* Makes it visible on dark backgrounds */
		border-radius: 50%;
		position: fixed;
		pointer-events: none; /* Prevents the dot from blocking clicks */
		z-index: 9999;
		transform: translate(-50%, -50%) scale(0);
		opacity: 0;
		transition: transform 0.15s ease-out, opacity 0.15s ease-out;
	}

	/* Active state with pulse animation */
	.custom-dot.active {
		transform: translate(-50%, -50%) scale(1);
		opacity: 1;
		animation: pulse-circle 1.5s infinite ease-in-out;
	}

	@keyframes pulse-circle {
		0%, 100% { transform: translate(-50%, -50%) scale(1); box-shadow: 0 0 0 0 rgba(249, 249, 249, 0.3); }
		50% { transform: translate(-50%, -50%) scale(1.3); box-shadow: 0 0 0 6px rgba(249, 249, 249, 0); }
	}
</style>
