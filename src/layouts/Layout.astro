---
import { ClientRouter } from 'astro:transitions';
import '../index.css';

interface Props {
	title: string;
	bodyClass?: string;
}

const { title, bodyClass = "" } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
