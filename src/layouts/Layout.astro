			</div>

			<!-- Mobile Menu Overlay -->
			<div id="mobile-menu" class="fixed inset-0 top-16 bg-[#0B0B0B] z-40 hidden md:hidden flex flex-col p-8 gap-6 text-sm tracking-[0.2em] uppercase font-bold border-t border-[#F9F9F9]/5">
				<a href="/engineering/professional-experience" class="hover:text-[#F9F9F9]/60 transition-colors py-2 border-b border-[#F9F9F9]/5">professional experience</a>
				<a href="/engineering" class="hover:text-[#F9F9F9]/60 transition-colors py-2 border-b border-[#F9F9F9]/5">engineering</a>
				<a href="/art-design" class="hover:text-[#F9F9F9]/60 transition-colors py-2 border-b border-[#F9F9F9]/5">art+design</a>
				<a href="/wwjdedits" class="hover:text-[#F9F9F9]/60 transition-colors py-2 border-b border-[#F9F9F9]/5">clothing</a>
