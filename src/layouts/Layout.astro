								<li><a href="/engineering/teacher-robot" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">teacher's robot</a></li>
								<li><a href="/engineering/alcohol-sensor" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">breath alcohol sensor demo</a></li>
								<li><a href="/engineering/automated-fluid-handling" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">automated fluid handling system</a></li>
								<li><a href="/engineering/automotive-uim" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">automotive user interface</a></li>
								<li><a href="/engineering/cubert" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">cable coordination</a></li>
								<li><a href="/art-design/modular-cutlery" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">modular cutlery</a></li>
								<li><a href="/art-design/triangle-toys" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">triangle toys</a></li>
								<li><a href="/art-design/experience-design" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">prototyping for experience design</a></li>
								<li><a href="/art-design/table-art" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">table art</a></li>
								<li><a href="/art-design/igloo" class="hover:text-[#F9F9F9] transition-colors text-[#F9F9F9]/60">igloo</a></li>
