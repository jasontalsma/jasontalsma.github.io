			<div class="ml-auto pl-4">
				<a href="/hola" class="text-lg  tracking-widest whitespace-nowrap">Jason Talsma</a>
			</div>
		</nav>

		<main>
			<slot />
		</main>

		<footer class="bg-[#0B0B0B] py-14 px-8 border-t border-[#F9F9F9]/5">
