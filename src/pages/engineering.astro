---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const engrProjectIds = [
	'remote',
	'ai-hardware',
	'teacher-robot',
	'alcohol-sensor',
	'automated-fluid-handling',
	'automotive-uim',
	'cubert'
];

const projects = await getCollection('pages');
const filteredProjects = engrProjectIds.map(id => projects.find(p => p.id === id)).filter(Boolean);
---

<Layout title="Engineering | Jason Talsma">
	<div class="pt-32 px-8 pb-20">
		<div class="max-w-7xl mx-auto">
			<div class="mb-20 space-y-4">
				<h1 class="text-xs tracking-[0.4em] uppercase text-[#F9F9F9]/40">Index</h1>
				<h2 class="text-xl md:text-2xl font-black tracking-tighter uppercase">Engineering</h2>
			</div>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
				{filteredProjects.map((project, index) => (
					<a 
						href={`/engineering/${project.id}`} 
						class="group space-y-4 animate-fade-in-up"
						style={`animation-delay: ${index * 0.1}s`}
					>
						<div class="relative aspect-[4/5] overflow-hidden bg-[#1A1A1A]">
							<img 
								src={`/images/${project.data.coverImage}`} 
								alt=""
								loading={index < 3 ? "eager" : "lazy"}
								class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 scale-100 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-[#0B0B0B]/20 group-hover:bg-transparent transition-colors"></div>
						</div>
						<div class="flex justify-between items-baseline">
							<h2 class="text-xs tracking-[0.2em] font-medium uppercase text-[#F9F9F9]/80">{project.data.title}</h2>
						</div>
					</a>
				))}
			</div>
		</div>
	</div>
</Layout>

<style>
	@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(20px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.animate-fade-in-up {
		opacity: 0;
		animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
</style>
