---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const engrProjectIds = [
    'remote',
    'ai-hardware',
    'teacher-robot',
    'alcohol-sensor',
    'automated-fluid-handling',
    'automotive-uim',
    'cubert',
    'professional-experience'
  ];
  const projects = await getCollection('pages');
  return projects
    .filter(entry => entry.id !== 'wwjdedits' && engrProjectIds.includes(entry.id))
    .map(entry => ({
      params: { slug: entry.id }, 
      props: { entry },
    }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'pages'> };
const { Content } = await render(entry);

const body = entry.body;
const italicMatch = body ? body.match(/_([\s\S]+?)_/) : null;
const projectBrief = italicMatch ? italicMatch[1] : "";

const isProfessionalExp = entry.id === 'professional-experience';
const layoutType = entry.data.layoutType || 'technical';

const textColorClass = entry.data.textColor === 'black' ? 'text-black' : 'text-white';
const mixBlendClass = entry.data.textColor === 'black' ? 'mix-blend-normal' : 'mix-blend-difference';
---

<Layout title={`${entry.data.title} | Jason Talsma`}>
  <section class={`${isProfessionalExp ? 'h-[75vh]' : 'h-screen'} relative w-full overflow-hidden`}>
    <div 
      class="absolute inset-0 bg-cover bg-center scale-105 animate-fade-to-color"
      style={`background-image: url('/images/${entry.data.coverImage}')`}
    ></div>
    
    <div class={`absolute inset-0 flex items-center px-4 md:px-32 ${isProfessionalExp ? 'justify-start' : 'justify-center'}`}>
      <div class={`${isProfessionalExp ? 'h-full max-w-4xl' : 'max-w-4xl'} w-full flex items-center`}>
        <div class={`backdrop-blur-sm saturate-120 bg-white/5 p-6 md:p-20 relative overflow-hidden group ${isProfessionalExp ? 'h-[85%] my-auto flex flex-col justify-center' : ''}`}>
           <h1 class={`${isProfessionalExp ? 'text-4xl md:text-7xl' : 'text-4xl md:text-8xl'} font-black tracking-tighter ${textColorClass} mb-6 md:mb-8 leading-[0.9] lowercase`}>
            {entry.data.title}
           </h1>
           {projectBrief && (
             <p class={`${isProfessionalExp ? 'text-base md:text-xl' : 'text-base md:text-2xl'} ${textColorClass} font-medium leading-tight max-w-2xl ${mixBlendClass}`}>
               <Fragment set:html={projectBrief} />
             </p>
           )}

           {isProfessionalExp && (
             <div class="mt-12 flex flex-col sm:flex-row gap-4">
                <a href="/docs/JasonTalsma_Resume" target="_blank" class="px-8 py-3 bg-white text-black text-[10px] tracking-widest uppercase font-bold hover:bg-white/90 transition-colors text-center">Download Resume</a>
                <a href="mailto:jason.talsma@gmail.com" class="px-8 py-3 bg-black border border-white/20 text-white text-[10px] tracking-widest uppercase font-bold hover:bg-white/10 transition-colors text-center">Contact</a>
             </div>
           )}
        </div>
      </div>
    </div>
  </section>

  <div class="bg-[#0B0B0B] text-[#F9F9F9]">
    {layoutType === 'organic' ? (
      <div class="py-20 px-8">
        <div class="max-w-7xl mx-auto">
          <div class="prose prose-invert max-w-none">
            <Content />
          </div>
        </div>
      </div>
    ) : (
      <div class="py-20 px-8">
        <div class="max-w-7xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-20 items-start">
             <div class="prose prose-invert h-fit">
                <Content />
             </div>
             
             <div class="grid grid-cols-2 gap-x-4 gap-y-10 max-h-[80vh] lg:sticky lg:top-24 overflow-y-auto pr-4 pb-40">
              {entry.data.images && entry.data.images.map((img: string, index: number) => (
                <div class={`group relative overflow-hidden bg-[#111] flex items-center justify-center ${index === 0 ? 'col-span-2 aspect-video' : 'col-span-1 aspect-square'}`}>
                  <img 
                    src={img} 
                    alt="" 
                    loading="lazy"
                    class="w-full h-full object-cover" 
                  />
                </div>
              ))}
              
              {!entry.data.images && (
                <>
                  <div class="col-span-1 aspect-video bg-[#111] flex items-center justify-center text-white/20 text-xs tracking-widest uppercase">
                      CAD Schema / Media Container
                  </div>
                  <div class="col-span-1 aspect-square bg-[#111] flex items-center justify-center text-white/20 text-xs tracking-widest uppercase">
                      Process Animation Element
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  function initScrollReveal() {
    const images = document.querySelectorAll('.prose img, .prose figure img, .grid img');
    
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -1% 0px',
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target); 
        }
      });
    }, observerOptions);

    images.forEach(img => observer.observe(img));
  }

  document.addEventListener('astro:page-load', initScrollReveal);
</script>

<style is:global>
  @reference "../../index.css";
  .prose h1, .prose h2, .prose h3, .prose h4 {
    @apply uppercase tracking-widest text-[#F9F9F9]/90 font-medium mt-12 mb-6 block;
  }
  .prose p, .prose li {
    @apply text-lg text-[#F9F9F9]/70 leading-relaxed font-light mb-4;
  }
  .prose li::marker {
    @apply text-[#F9F9F9]/40;
  }
  .prose ul, .prose ol {
    @apply mb-8;
  }
  .prose strong {
    @apply text-white font-medium;
  }
  .prose figure, 
  .prose p > img, 
  .prose iframe, 
  .prose > div:has(> img:only-child) {
    @apply my-16 block;
  }
  .prose div[class*="grid-cols-"],
  .prose div[class*="gap-"] {
    margin-top: 4rem;
    margin-bottom: 4rem;
  }
  .prose figure img, .prose img:not(.not-prose), .grid img {
    @apply w-full grayscale brightness-50 transition-all duration-2000 ease-out;
  }
  .prose figure img.in-view {
    @apply grayscale-0 brightness-100;
  }
  .prose img:not(.not-prose).in-view {
    @apply grayscale-0 brightness-100;
  }
  .grid img.in-view {
    @apply grayscale-0 brightness-100;
  }

  @keyframes fadeToColor {
    from {
      filter: grayscale(100%) brightness(0.70);
    }
    to {
      filter: grayscale(0%) brightness(100%);
    }
  }
  .animate-fade-to-color {
    animation: fadeToColor 6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
  .prose p:first-of-type em, 
  .prose p:first-of-type i {
    @apply hidden;
  }
</style>