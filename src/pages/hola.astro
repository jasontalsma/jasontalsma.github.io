  const project = projects.find(p => p.data.coverImage === filename);
  return { filename, project };
});
---

<Layout title="Hola | Jason Talsma">
  <div class="relative w-full mt-16 bg-black cursor-none min-h-screen overflow-y-auto">
    <div id="hola-content-wrapper" class="relative w-full">
      
      <div class="grid grid-cols-3 gap-0 pointer-events-none opacity-100 z-10">
        {displayItems.map((item) => (
          <div class="relative aspect-square overflow-hidden">
            <img 
              src={`/images/nature/${item.filename}`} 
              class="w-full h-full object-cover" 
              alt=""
            />
          </div>
        ))}
      </div>

      <div id="project-titles" class="absolute inset-0 z-20 pointer-events-none overflow-hidden mix-blend-difference font-black" style="opacity: 0;">
        {(() => {
          const importantOrder = ['mycelium', 'wwjdedits', 'teacher-robot', 'remote', 'wwjd'];
          
          const sortedProjects = [...projects].sort((a, b) => {
            const indexA = importantOrder.indexOf(a.id);
            const indexB = importantOrder.indexOf(b.id);
            if (indexA !== -1 && indexB !== -1) return indexA - indexB;
            if (indexA !== -1) return -1;
            if (indexB !== -1) return 1;
            return 0;
          });

          return [...sortedProjects, ...sortedProjects].map((project, index) => {
            const isBottomSet = index >= projects.length;
            const projectIndex = index % projects.length;
            const titleSeed = project.id + (isBottomSet ? 'bottom' : 'top');
            const seed = titleSeed.split('').reduce((acc, char) => acc + char.charCodeAt(0), 0);
            
            const x = (seed * 19) % 60 + 5;
            const verticalStep = 200;
            const yOffset = isBottomSet ? (projects.length * verticalStep * 0.8) : 50;
            const y = (seed * 23) % 200 + (projectIndex * verticalStep) + yOffset; 
            const artDesignProjects = ['mycelium', 'triangle-toys', 'igloo', 'modular-cutlery', 'experience-design', 'table-art'];
            const href = project.id === 'wwjdedits' ? '/wwjdedits' : project.id === 'wwjd' ? '/wwjd' : artDesignProjects.includes(project.id) ? `/art-design/${project.id}` : `/engineering/${project.id}`;
            
            return (
              <a 
                href={href}
                class="absolute text-[1.7rem] md:text-[3.375rem] font-black uppercase tracking-tighter leading-none hover:text-white transition-colors cursor-pointer pointer-events-auto whitespace-nowrap opacity-90 text-[#F9F9F9]"
                style={`left: ${x}%; top: ${y}px; transform: rotate(${(seed % 10) - 5}deg);`}
              >
                {project.data.title}
              </a>
            );
          });
        })()}
      </div>

      <div 
        id="flashlight" 
        class="absolute z-30 pointer-events-none rounded-full mix-blend-difference backface-hidden" 
        style="width: 25vw; height: 25vw; transform: translate(-50%, -50%); display: none; background: rgba(255,255,255,1);"
        >
      </div>
    </div>
  </div>

  <script>
  // This function boots the layout listeners safely on every page view
  function initFlashlight() {
    const scrollContainer = document.querySelector('.overflow-y-auto') as HTMLElement;
    const contentWrapper = document.getElementById('hola-content-wrapper');
    const flashlight = document.getElementById('flashlight');
    const titlesLayer = document.getElementById('project-titles');

    if (scrollContainer && contentWrapper && flashlight && titlesLayer) {
      scrollContainer.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = contentWrapper.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        flashlight.style.display = 'block';
        flashlight.style.left = `${x}px`;
        flashlight.style.top = `${y}px`;

        const mask = `radial-gradient(circle 12.5vw at ${x}px ${y}px, black 0%, transparent 100%)`;
        titlesLayer.style.opacity = '1';
        // @ts-ignore
        titlesLayer.style.webkitMaskImage = mask;
        // @ts-ignore
        titlesLayer.style.maskImage = mask;
      });

      scrollContainer.addEventListener('mouseleave', () => {
        flashlight.style.display = 'none';
        titlesLayer.style.opacity = '0';
      });
    }
  }

  // Intercept Astro view transitions / routing updates
  document.addEventListener('astro:page-load', initFlashlight);
  </script>
</Layout>

<style>
  #project-titles {
    color: #F9F9F9;
    -webkit-mask-image: none;
    mask-image: none;
  }
</style>