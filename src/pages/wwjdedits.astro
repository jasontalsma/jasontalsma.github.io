---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('pages', 'wwjdedits');

if (!entry) {
  return Astro.redirect('/404');
}

const { Content } = await render(entry);

// Extract the first italicized block: _text_ or *text*
const body = entry.body;
const italicMatch = body ? body.match(/_([^_]+)_/) : null;
const projectBrief = italicMatch ? italicMatch[1] : "";

const isClothing = true;
const layoutType = entry.data.layoutType || 'technical';
---

<Layout 
  title={`${entry.data.title} | Jason Talsma`}
  bodyClass="clothing-page"
>
  <!-- Hero Section -->
  <section class="h-[75vh] relative w-full overflow-hidden">
    <div 
      class="absolute inset-0 bg-cover bg-center scale-105 animate-fade-to-color"
      style={`background-image: url('/images/${entry.data.coverImage}')`}
    ></div>
    
    <div class="absolute inset-0 flex items-center px-4 md:px-32 justify-start">
      <div class="h-full max-w-4xl w-full flex items-center">
        <div class="backdrop-blur-sm saturate-120 bg-white/5 p-6 md:p-20 relative overflow-hidden group h-[85%] my-auto flex flex-col justify-center">
           <!-- Text Overlay -->
           <h1 class="text-4xl md:text-7xl font-black tracking-tighter text-white mb-6 md:mb-8 leading-[0.9] lowercase">
            {entry.data.title}
           </h1>

           <div class="mt-8 flex items-center gap-4">
             <span class="text-xs tracking-[0.4em] uppercase text-[#F9F9F9]/40">BY</span>
             <a 
               href="https://www.instagram.com/wwjdedits/" 
               target="_blank" 
               class="inline-flex items-center gap-3 text-white hover:text-white/60 transition-all group"
             >
               <svg class="w-8 h-8 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
               <span class="text-xl tracking-widest uppercase font-bold">wwjdedits</span>
             </a>
           </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <div class="bg-[#0B0B0B] text-[#F9F9F9]">
    <div class="py-20 px-8">
      <div class="max-w-7xl mx-auto">
         <div class="space-y-32">
            <div class="prose prose-invert max-w-none prose-p:first:italic prose-p:first:text-[#F9F9F9]/70">
              <Content />
            </div>

            <!-- Gallery 1: Clothing 1-5 -->
            <div class="space-y-12">
              <h2 class="text-2xl font-black uppercase tracking-tighter border-b border-white/10 pb-4">designed by wwjd</h2>
              <div class="grid grid-cols-1 md:grid-cols-6 gap-8">
                {entry.data.gallery1 && entry.data.gallery1.slice(0, 3).map((img: string) => (
                  <div class="group relative aspect-[3/4] overflow-hidden bg-[#111] md:col-span-2">
                    <img 
                      src={`/images/${img}`} 
                      alt="" 
                      class="w-full h-full object-cover" 
                    />
                  </div>
                ))}
                {entry.data.gallery1 && entry.data.gallery1.slice(3, 5).map((img: string, idx: number) => (
                  <div class={`group relative aspect-square overflow-hidden bg-[#111] md:col-span-2 ${idx === 0 ? 'md:col-start-2' : ''}`}>
                    <img 
                      src={`/images/${img}`} 
                      alt="" 
                      class="w-full h-full object-cover" 
                    />
                  </div>
                ))}
              </div>
            </div>

            <!-- Gallery 2: The rest -->
            <div class="space-y-12">
              <h2 class="text-2xl font-black uppercase tracking-tighter border-b border-white/10 pb-4">edited by wwjd</h2>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-8">
                {entry.data.gallery2 && entry.data.gallery2.map((img: string) => (
                  <div class="group relative aspect-[3/4] overflow-hidden bg-[#111]">
                    <img 
                      src={`/images/${img}`} 
                      alt="" 
                      class="w-full h-full object-cover" 
                    />
                  </div>
                ))}
              </div>
            </div>

            <div class="flex items-center gap-4 py-8 border-t border-white/10 opacity-0 pointer-events-none">
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              <a href="https://www.instagram.com/wwjdedits/" target="_blank" class="text-sm tracking-widest uppercase font-bold hover:underline">wwjdedits</a>
            </div>
         </div>
      </div>
    </div>
  </div>
</Layout>



<script>
  function initScrollReveal() {
    // Selects body markdown images and right-hand side preview grid layout images
    const images = document.querySelectorAll('.prose img, .prose figure img, .grid img');
    
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -1% 0px', // Triggers slightly before crossing viewport base frame boundary
      threshold: 0.15
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target); 
        }
      });
    }, observerOptions);

    images.forEach(img => observer.observe(img));
  }

  // Bind to dynamic layout adjustments safely
  document.addEventListener('astro:page-load', initScrollReveal);
</script>

<style is:global>
  @reference "../index.css";
  .prose h1, .prose h2, .prose h3, .prose h4 {
    @apply uppercase tracking-widest text-[#F9F9F9]/90 font-medium mt-12 mb-6 block;
  }
  .prose p, .prose li {
    @apply text-lg text-[#F9F9F9]/70 leading-relaxed font-light mb-4;
  }
  .prose li::marker {
    @apply text-[#F9F9F9]/40;
  }
  .prose ul, .prose ol {
    @apply mb-8;
  }
  .prose strong {
    @apply text-white font-medium;
  }
  .prose figure, .prose p > img {
    @apply my-16 block;
  }
  .prose figcaption {
    @apply mt-6 text-sm text-[#F9F9F9]/40 font-light tracking-wide max-w-2xl;
  }
  
  .prose figure img, .prose img:not(.not-prose), .grid img {
    @apply w-full grayscale brightness-50 transition-all duration-2000 ease-out;
  }
  .prose figure img.in-view {
    @apply grayscale-0 brightness-100;
  }
  .prose img:not(.not-prose).in-view {
    @apply grayscale-0 brightness-100;
  }
  .grid img.in-view {
    @apply grayscale-0 brightness-100;
  }

  @keyframes fadeToColor {
  from {
    filter: grayscale(100%) brightness(0.70);
  }
  to {
    filter: grayscale(0%) brightness(100%);
  }
  }
  .animate-fade-to-color {
    animation: fadeToColor 6s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }

  /* Remove the italicized paragraph from the main content since it's in the hero */
  /* Except on pages where we explicitly want to show it (like clothing) */
  body:not(.clothing-page) .prose p:first-of-type em, 
  body:not(.clothing-page) .prose p:first-of-type i {
    @apply hidden;
  }
</style>
